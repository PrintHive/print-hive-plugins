{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://printhiv3d.com/schemas/morning-cos-brief/v1.json",
  "title": "MorningCoSBriefV1",
  "description": "Canonical payload for the Mon–Sat morning chief-of-staff brief.",
  "type": "object",
  "required": [
    "version",
    "generatedAt",
    "timezone",
    "quiet",
    "materialChanged",
    "shipping",
    "blocked",
    "needsOperator",
    "sourcesPolled"
  ],
  "properties": {
    "version": { "const": "1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "timezone": { "const": "America/Denver" },
    "quiet": {
      "type": "boolean",
      "description": "true when nothing material to report; consumer should stay silent. Invert of materialChanged."
    },
    "materialChanged": {
      "type": "boolean",
      "description": "true iff any of shipping, blocked, or needsOperator has items. Invert of quiet."
    },
    "shipping": { "type": "array", "items": { "$ref": "#/$defs/item" } },
    "blocked": { "type": "array", "items": { "$ref": "#/$defs/item" } },
    "needsOperator": { "type": "array", "items": { "$ref": "#/$defs/item" } },
    "sourcesPolled": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "Exact labels of sources polled this run"
    },
    "notes": {
      "type": "string",
      "description": "Optional. Use to say a source did not answer; never invent farm metrics here"
    },
    "floor": {
      "type": "object",
      "description": "Optional farm floor snapshot from Print Hive MCP reads only",
      "additionalProperties": false,
      "properties": {
        "queued": { "type": "number" },
        "schedulable": { "type": "number" },
        "pauses": { "type": "array", "items": { "type": "string" } },
        "clearBeds": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "required": ["source", "summary"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "evidence": { "type": "string" },
        "owner": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
