{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://printhiv3d.com/schemas/morning-cos-brief/v1.json",
  "title": "MorningCoSBriefV1",
  "description": "Canonical payload for the Mon–Sat morning CoS brief. Owned with Daily Brief. No SSR Daily Brief card fields.",
  "type": "object",
  "required": ["version", "generatedAt", "timezone", "quiet", "materialChanged", "shipping", "blocked", "needsJerrod", "sourcesPolled"],
  "properties": {
    "version": { "const": "1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "timezone": { "const": "America/Denver" },
    "quiet": {
      "type": "boolean",
      "description": "true when nothing material to report; consumer should stay silent. Invert of materialChanged."
    },
    "materialChanged": {
      "type": "boolean",
      "description": "true iff any of shipping/blocked/needsJerrod has items. Invert of quiet."
    },
    "shipping": { "type": "array", "items": { "$ref": "#/$defs/item" } },
    "blocked": { "type": "array", "items": { "$ref": "#/$defs/item" } },
    "needsJerrod": { "type": "array", "items": { "$ref": "#/$defs/item" } },
    "sourcesPolled": {
      "type": "array",
      "items": { "$ref": "#/$defs/source" },
      "description": "Crew bots actually polled this run (exact allowlist strings)"
    },
    "notes": {
      "type": "string",
      "description": "Optional. Use to say a source did not answer; never invent farm metrics here"
    },
    "floor": {
      "type": "object",
      "description": "Optional farm floor snapshot from hive-mcp reads only",
      "additionalProperties": false,
      "properties": {
        "queued": { "type": "number" },
        "schedulable": { "type": "number" },
        "pauses": { "type": "array", "items": { "type": "string" } },
        "clearBeds": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "source": {
      "type": "string",
      "enum": [
        "Pulse",
        "PrintHive",
        "Comb",
        "Vertex",
        "Ryujin",
        "Quill",
        "Wisp",
        "Mochi",
        "Closer",
        "Cap",
        "hive-mcp"
      ]
    },
    "item": {
      "type": "object",
      "required": ["source", "summary"],
      "properties": {
        "source": { "$ref": "#/$defs/source" },
        "summary": { "type": "string" },
        "evidence": { "type": "string" },
        "owner": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
